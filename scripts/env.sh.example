#!/usr/bin/env bash
# Copy this file to scripts/env.sh and fill in the values.
# scripts/env.sh is gitignored — never commit real secrets.
#
# All variables marked REQUIRED must be set or scripts/deploy.sh will refuse
# to run. Optional variables enable specific add-on features; leaving them
# empty disables that feature only.

# =============================================================================
# Section 1 — Azure identity                                          REQUIRED
# =============================================================================

# Azure subscription ID (GUID). Get it from `az account show --query id -o tsv`
# after `az login`. The deploy account must have Contributor on this scope.
export SUBSCRIPTION=""

# Resource group name. Will be created if missing (preflight.sh checks).
# Must be unique within your subscription. Example: "openclaw-rg".
export RG=""

# Azure region. Pick one close to you that supports Container Instances and
# the Azure OpenAI models you plan to call. Example: "eastus", "westeurope".
export LOCATION="eastus"

# =============================================================================
# Section 2 — Resource naming                                         REQUIRED
# =============================================================================

# Azure Container Registry name. Globally unique, lowercase alphanumeric only,
# 5–50 chars. Will become "<ACR_NAME>.azurecr.io". Example: "myorgopenclawacr".
export ACR_NAME=""

# Custom-image revision suffix. Bump whenever docker/Dockerfile or
# docker/openclaw-init.sh change. Leave alone for upstream-only updates.
# Image tags become "openclaw:custom-<upstream>-<WRAPPER_REV>".
export WRAPPER_REV="1"

# Container Instance name within the resource group. Example: "openclaw".
export CONTAINER=""

# DNS label for the public FQDN. Becomes "<DNS_LABEL>.<region>.azurecontainer.io".
# Globally unique within the region. Example: "myorg-openclaw".
export DNS_LABEL=""

# Azure Storage account for the workspace file share (persisted state across
# redeploys). Globally unique, 3–24 lowercase alphanumeric chars.
# Example: "myorgopenclawstg".
export STORAGE_ACCOUNT=""

# File share name within the storage account. Default is fine for most setups.
export WORKSPACE_SHARE="openclaw-workspace"

# Mount path inside the container. Default is fine for most setups.
export WORKSPACE_MOUNT="/mnt/openclaw-workspace"

# CPU cores and memory (GB) for the container. 2/4 is the recommended minimum.
export CPU="2"
export MEMORY="4"

# =============================================================================
# Section 3 — LLM providers                              FIRST 3 REQUIRED
# =============================================================================

# Azure OpenAI / Foundry API key. Create a deployment in Azure AI Foundry,
# then grab the key from "Keys and Endpoint" in the resource overview.
export AZURE_OPENAI_API_KEY=""

# Azure OpenAI endpoint base URL. Format:
#   https://<your-aoai-resource>.openai.azure.com/openai/v1
# Used directly in config/config.template.json.
export AOAI_BASE_URL=""

# The Azure OpenAI resource name (the "<your-aoai-resource>" part above).
# Used in places where only the name (not the full URL) is needed.
export AOAI_RESOURCE_NAME=""

# NVIDIA Build API key (optional). Free OpenAI-compatible endpoint with open
# preview-tier models. Get one at https://build.nvidia.com/settings/api-keys.
# Leave empty to disable NVIDIA fallback models.
export NVIDIA_API_KEY=""

# Gemini CLI API key (optional). Free key from https://aistudio.google.com/apikey
# (60 req/min, 1000 req/day). Enables /acp spawn gemini for native YouTube
# ingestion etc. Leave empty to disable.
export GEMINI_API_KEY=""

# =============================================================================
# Section 4 — Channels                                                REQUIRED
# =============================================================================

# Telegram bot token. Create a bot via @BotFather in Telegram:
#   /newbot → pick name → pick username → copy token here.
# Then run /setprivacy → Disable so the bot sees all group messages.
export TELEGRAM_BOT_TOKEN=""

# Your Telegram numeric user ID. Get it by messaging @userinfobot.
# Used as the DM allowlist so only you can DM the bot.
export TELEGRAM_OWNER_ID=""

# Brave Search API key. Required for the web search skill.
# Get one at https://api.search.brave.com/app/keys (free tier available).
export BRAVE_SEARCH_API=""

# =============================================================================
# Section 5 — Optional add-ons                                        OPTIONAL
# =============================================================================

# Cloudflare Tunnel token (optional). Enables HTTPS access via cloudflared
# instead of the raw HTTP IP. Create a tunnel at one.dash.cloudflare.com →
# Networks → Tunnels → Create. Copy the token from the connector install
# command. Leave empty to skip the tunnel; you'll use the public IP directly.
export CF_TUNNEL_TOKEN=""

# Gateway shared-secret token (optional). If set, OpenClaw uses this exact
# token across redeploys so browsers stay connected without re-pasting.
# If empty, OpenClaw generates a fresh random token on every startup.
# To rotate: openssl rand -hex 24 → paste here → run deploy.sh.
export GATEWAY_TOKEN=""

# Phone Control Service Principal (optional). Enables iOS Shortcuts to
# start/stop/check the container via the Azure REST API. Create with:
#   az ad sp create-for-rbac --name openclaw-phone-control \
#     --role "Azure Container Instances Contributor Role" \
#     --scopes /subscriptions/$SUBSCRIPTION/resourceGroups/$RG/providers/\
# Microsoft.ContainerInstance/containerGroups/$CONTAINER
# Leave empty to skip iOS shortcut generation.
export PHONE_CONTROL_TENANT_ID=""
export PHONE_CONTROL_CLIENT_ID=""
export PHONE_CONTROL_CLIENT_SECRET=""
